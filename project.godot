config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Grin-Bit"
config/description="This Is Grin-Bit Indie Game Made By Humble Knight Games (HKG) Founded By KeyBhudda "
run/main_scene="uid://qojtnvgumkc"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://c5ymtve60lch6"

[autoload]

GameState="*res://scripts/game_state.gd"
GlobalData="*res://scripts/GlobalData.gd"
Player_Lives="*res://scripts/player_lives.gd"
FadeScreen="*uid://cxqioggtjon38"

[display]

window/stretch/mode="canvas_items"

[global_group]

Player=""
deathscreen="just the \"you died\" text"
Score="To Recognize the score label"
Token="all tokens "
K-Tokens="all K-Tokens"
DeathTimer=""
foods="All Fruits and other food items"
ChaseTimer=""
SwitchTimer=""
Element=""
FightTimer=""
LivesDisplay="The Visuals For How Many Lives Are Left."
ResetTimer=""

