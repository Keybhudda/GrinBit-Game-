[sub_resource type="GDScript" id="GDScript_pl11u"]
script/source = "extends Node
#This Script is used to keep tract of game progress and items

var coins = 0
var kcoins = 0
var lives = 3
var collected_items = {}

func coin_collected():
	coins += 1
	print(\"tokens = \", coins)
func kcoin_collected():
	kcoins += 1
	print(\"kcoins = \", kcoins)
func item_collected(item_name: String):
	collected_items[item_name] = true
	print(item_name, \" colletected!\")
"

